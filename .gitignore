# ============================================================
# NeoDesk Console — .gitignore
# Organized by category, no duplicate patterns
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Python distutils 'lib/' build output (root-level only — must NOT match
# Tauri/SolidJS client src/lib directories like
# neodesk-agent-client/src/lib or neodesk-mgmt/src/lib).
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
instance/
.webassets-cache

# --- Rust ---
target/
.cargo-cache/
# Note: Cargo.lock is committed for application crates (reproducible builds + Dependabot)
**/*.rs.bk
*.pdb

# --- Node.js ---
node_modules/
# --- IDEs & OS ---
.vscode/
.idea/
.playwright-mcp/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.Spotlight-V100
.Trashes

# --- Logs ---
*.log
logs/

# --- Database files ---
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db
*.db-shm
*.db-wal

# --- Runtime state (must NEVER be committed; corrupts user installs on update) ---
# The old Node console's folder is gone from the tree; what an older
# checkout left in it (data, uploads, wallpapers) stays out of git
web-nodejs/
.session_secret
.update_sha
.api_key
.admin_credentials
.force_password_update

# --- Temporary files & caches ---
*.tmp
*.temp
.tmp-*
.tmp-dep-test/
/tmp/
.cache/

# --- Backups ---
*.bak
*.backup
*backup*/
# The console's Server › Backups page is source, not a backup
!web-ui/src/routes/(console)/server/backups/
rustdesk-backup*/
rustdesk-backup-*/

# --- Environment & secrets ---
.env
.env.local
.env.*.local
config.local.*
*_local.sh
*_local.ps1
*credentials*
!docker/show-admin-credentials.sh
!docker/bootstrap-admin-credentials.sh
*.password
*.passwords
*_password.txt
*_password.log
*secret*.key
*secret*.pem

# --- Cryptographic keys & certificates ---
*.key
*.pem
*.pub
id_*

# --- Sensitive internal documents (security audits, reports) ---
docs/_internal/
*REPORT*.md
.security_scan_report.md

# --- Testing ---
.coverage
htmlcov/
.pytest_cache/
.local-test-results/
test_*.sh
verify_*.sh
TESTING.local.md

# --- Test screenshots (moved from root to screenshots/tests/) ---
screenshots/tests/
/test-*.png

#visual_studio
.vs/CopilotSnapshots
.vs/

# --- Temporary test scripts (contain credentials/URLs — moved to dev_modules/) ---
tmp_test_*.py
tmp_test_*.sh

# --- Archive (old files with potential sensitive data; repo root only) ---
/archive/

# --- Legacy binaries ---
hbbs-patch/
hbbs-patch-v2/
hbbs-v[0-7]-patched
hbbr-v[0-7]-patched

# --- Dev scripts (old Flask/Rust-era utilities) ---
dev_modules/
scripts/legacy/
migrations/
templates/
!deploy/helm/neodesk/templates/
test_api.sh
build_windows.sh
_write_readme.py

# --- NeoDesk desktop clients / agents (legacy local trees — not shipped via panel) ---
# Active sources may live only on disk as *_old after local renames; keep out of git.
neodesk-mgmt/
neodesk-mgmt_old/
neodesk-agent/
neodesk-agent_old/
neodesk-agent-client/
neodesk-agent-client_old/
neodesk-desktop/
neodesk-desktop_old/
rdclient-desktop/
rdclient-desktop_old/
# neodesk-agent-client/ binaries (if tree is restored later)
neodesk-agent-client/src-tauri/binaries/**
!neodesk-agent-client/src-tauri/binaries/.gitkeep
neodesk-agent-client_old/src-tauri/binaries/**
!neodesk-agent-client_old/src-tauri/binaries/.gitkeep

# --- NeoDesk Agent binaries & config (compiled locally) ---
neodesk-agent/neodesk-agent
neodesk-agent/neodesk-agent-*
neodesk-agent/*.exe
neodesk-agent/deploy-config.json
neodesk-agent/*.json
neodesk-agent/create_key.py
neodesk-agent/fix_devid.py
neodesk-agent/fix_type.py
neodesk-agent/update_config.py
!neodesk-agent/package.json
neodesk-agent_old/neodesk-agent
neodesk-agent_old/neodesk-agent-*
neodesk-agent_old/*.exe
neodesk-agent_old/*.json
!neodesk-agent_old/package.json

# --- NeoDesk Go server binaries (compiled locally) ---
neodesk-server/neodesk-server
neodesk-server/neodesk-server-*
neodesk-server/*.exe
neodesk-server/*.key
neodesk-server/*.pem
neodesk-server/id_ed25519*
neodesk-server/test_*.go
neodesk-server/_test_*

# --- Screenshots ---
screenshots/*.png
!screenshots/.gitkeep

# --- Deployment temporary files & artifacts ---
_deploy_tmp/
_server_checksums.txt
deploy_console.tar.gz
*.tar.gz

# --- Operator-only runbooks (copy from *.example.md into docs/private/) ---
docs/private/
docs/important/neodesk-server-deploy-paths.md

# --- Internal dev/analysis documents (not for public repo) ---
.github/audyt_bezpieczenstwa.md
.github/RUSTDESK_SZYFROWANIE.md
.github/rustdesk_client_server_data_analysis.md
.github/rustdesk_encryption_analysis.md
.github/new_functions.md
.github/rustdesk_client.md

# --- Playwright MCP screenshots ---
.playwright-mcp/

# --- Task tracking (local only) ---
tasks/todo.md

docs/security/PROJECT_SECURITY_ANALYSIS_2026-05-19.md
